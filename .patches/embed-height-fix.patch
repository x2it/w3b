   }
-  function _showIframe(containerId, fallbackId, iframeEl, height) {
+  /* 当前每个 iframe 最后一次成功应用的「原始高度」（来自 postMessage），
+     resize 时用它重新夹紧，避免桌面↔移动断点切换后高度不对。 */
